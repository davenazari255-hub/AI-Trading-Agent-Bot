# Mooo configuration. Create .env with `make env` (it generates local secrets).
# Never commit .env. Never put real trading credentials in this file.

APP_ENV=development

# Initial Active Environment. demo = Bybit Demo Trading (default).
BYBIT_ENV=demo

# Live Trading is off. true only allows the Operator to enable Live in the dashboard.
# It never enables Live by itself.
ALLOW_LIVE_TRADING=false

# AI provider (behind an abstraction). The key is optional until the agent work orders.
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=

# PostgreSQL (used by docker-compose and DATABASE_URL)
POSTGRES_USER=mooo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mooo
DATABASE_URL=postgresql+asyncpg://mooo:change-me@postgres:5432/mooo

REDIS_URL=redis://redis:6379/0

# 32 random bytes, base64. `make env` generates it. Required.
MOOO_MASTER_KEY=

# Caddy site address. Use your domain on a VPS for automatic HTTPS.
SITE_ADDRESS=localhost

LOG_LEVEL=INFO

# News providers: none is enabled by default. Enable per provider, for example:
# NEWS_PROVIDERS__BYBIT_ANNOUNCEMENTS=true

# Deployment ceilings: hard bounds for dashboard settings. Not defaults, not targets.
# CEILINGS__MAX_WATCHLIST_CAPACITY=50
# CEILINGS__MAX_AI_ANALYSES_PER_HOUR=120
# CEILINGS__MIN_DEEP_ANALYSIS_COOLDOWN_MINUTES=5
# CEILINGS__MIN_ANCHOR_REVIEW_MINUTES=15
# CEILINGS__MAX_LEVERAGE=10
# CEILINGS__MAX_REGIME_LEVERAGE_CAP=5
# CEILINGS__MIN_LIQUIDATION_BUFFER=1.5
# CEILINGS__MAX_LOSS_PER_TRADE_PCT=2
# CEILINGS__MAX_DAILY_LOSS_PCT=10
# CEILINGS__MAX_DRAWDOWN_PCT=25
