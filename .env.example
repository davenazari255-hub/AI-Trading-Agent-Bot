# Mooo deployment configuration.
# Copy to .env with `make env` (it also generates MOOO_MASTER_KEY and the database password).
# Never commit .env.

# --- Application ---
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Exchange ---
# Initial Active Environment only: demo | live. Live still requires Live Trading Enablement.
BYBIT_ENV=demo
# Must be true before Live can be enabled. BYBIT_ENV=live is refused at startup unless this is true.
ALLOW_LIVE_TRADING=false

# --- AI ---
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# Leave empty until the AI agent stage. Never commit a real key.
ANTHROPIC_API_KEY=

# --- Data stores ---
POSTGRES_USER=mooo
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=mooo
DATABASE_URL=postgresql+asyncpg://mooo:change-me-postgres-password@postgres:5432/mooo
REDIS_URL=redis://redis:6379/0

# --- Credential Vault ---
# 32 random bytes, base64 or hex encoded. Generate with: openssl rand -base64 32
# Keep a secure backup: encrypted credentials cannot be read without it.
MOOO_MASTER_KEY=

# --- News providers ---
# Comma-separated provider names to enable. Empty by default: no provider is enabled.
# Provider credentials are entered in the dashboard and stored encrypted, not here.
# Example (Bybit announcements are optional and disabled by default):
# NEWS_PROVIDERS=bybit_announcements
NEWS_PROVIDERS=

# --- Agent Worker ---
# WORKER_ROLE is set per service in docker-compose.yml (live | backtest).
WORKER_LOCK_TTL_SECONDS=15
# Must be at most half of WORKER_LOCK_TTL_SECONDS.
WORKER_LOCK_HEARTBEAT_SECONDS=5
WORKER_HEALTH_PORT=8081

# --- Reverse proxy ---
# Public domain for automatic HTTPS on a VPS. localhost uses Caddy's local CA.
MOOO_DOMAIN=localhost

# --- Deployment Ceilings ---
# Hard bounds that dashboard settings cannot exceed. MAX_* are upper bounds, MIN_* are lower bounds.
# A MAX_* ceiling must be at least the initial conservative default it bounds, and a MIN_* floor
# must be at most that default. Values below are deployment limits, not recommended settings.
# Discovery
CEILINGS__MAX_DYNAMIC_WATCHLIST_CAPACITY=50
CEILINGS__MIN_FAST_SCAN_INTERVAL_SECONDS=15
CEILINGS__MIN_INSTRUMENT_REFRESH_MINUTES=15
# Agent
CEILINGS__MAX_AI_ANALYSIS_BUDGET_PER_HOUR=120
CEILINGS__MIN_DEEP_ANALYSIS_COOLDOWN_MINUTES=5
CEILINGS__MIN_ANCHOR_REVIEW_INTERVAL_MINUTES=15
# Risk (percentages are percent values, for example 2 means 2 percent)
CEILINGS__MAX_LOSS_PER_TRADE_PCT=2
CEILINGS__MAX_ACCOUNT_EXPOSURE_PCT=6
CEILINGS__MAX_POSITION_SIZE_PCT=50
CEILINGS__MAX_LEVERAGE=10
CEILINGS__MAX_REGIME_LEVERAGE_CAP=5
CEILINGS__MAX_LEVERAGE_REDUCTION_FACTOR=1
CEILINGS__MIN_LIQUIDATION_BUFFER=1.5
CEILINGS__MAX_SIMULTANEOUS_POSITIONS=10
CEILINGS__MAX_DAILY_LOSS_PCT=5
CEILINGS__MAX_DRAWDOWN_PCT=20
CEILINGS__MAX_CORRELATED_EXPOSURE_PCT=3
CEILINGS__MAX_TOTAL_MARGIN_USAGE_PCT=60
CEILINGS__MIN_TURNOVER_24H_USDT=10000000
CEILINGS__MIN_REWARD_RISK=1
CEILINGS__MAX_SPREAD_PCT=0.2
CEILINGS__MAX_SLIPPAGE_PCT=0.5
